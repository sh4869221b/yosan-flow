{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true
  },
  "include": [
    "src",
    "test",
    "tests",
    "scripts",
    "*.config.ts",
    "vite.config.js"
  ],
  "exclude": ["node_modules", "src/service-worker"]
}
