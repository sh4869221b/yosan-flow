{
  "name": "yosan-flow",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "vite dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings=0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:ci": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test:unit": "vitest run --passWithNoTests tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage tests/unit tests/integration",
    "test:e2e": "svelte-kit sync && playwright test",
    "build": "vite build",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:check": "drizzle-kit check",
    "db:verify": "pnpm db:check && vitest run tests/migrations",
    "cf:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf:reset:local": "rm -rf .wrangler/state/v3/d1 .tmp-wrangler-state/v3/d1 && wrangler d1 migrations apply DB --local",
    "cf:migrate:preview": "wrangler d1 migrations apply DB --env preview --remote",
    "cf:migrate:production": "wrangler d1 migrations apply DB --env production --remote",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy:production": "wrangler deploy --env production",
    "fallow": "svelte-kit sync && fallow",
    "fallow:dead-code": "svelte-kit sync && fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "svelte-kit sync && fallow health",
    "fallow:ci": "svelte-kit sync && node scripts/fallow-ci.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "fallow": "3.30.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "wrangler": "^4.144.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "bits-ui": "^2.19.3",
    "drizzle-orm": "^0.45.3",
    "effect": "^3.22.2",
    "@lucide/svelte": "^1.49.0"
  }
}
