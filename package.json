{
  "name": "yosan-flow",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@12.16.0",
  "scripts": {
    "dev": "vite dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings=0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:ci": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test:unit": "vitest run --passWithNoTests tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage tests/unit tests/integration",
    "test:e2e": "bash scripts/e2e-container.sh",
    "build": "vite build",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:check": "drizzle-kit check",
    "db:verify": "pnpm db:check && vitest run tests/migrations",
    "cf:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf:reset:local": "rm -rf .wrangler/state/v3/d1 .tmp-wrangler-state/v3/d1 && wrangler d1 migrations apply DB --local",
    "cf:migrate:preview": "wrangler d1 migrations apply DB --env preview --remote",
    "cf:migrate:production": "wrangler d1 migrations apply DB --env production --remote",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy:production": "wrangler deploy --env production",
    "fallow": "svelte-kit sync && fallow",
    "fallow:dead-code": "svelte-kit sync && fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "svelte-kit sync && fallow health",
    "fallow:ci": "svelte-kit sync && node scripts/fallow-ci.ts",
    "test:e2e:worker": "svelte-kit sync && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-cloudflare": "^8.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "fallow": "3.36.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.62.0",
    "bits-ui": "^2.20.2",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "effect": "^4.0.6",
    "tailwind-variants": "^3.3.1"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
